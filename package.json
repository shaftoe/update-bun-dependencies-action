{
  "name": "update-bun-dependencies-action",
  "version": "0.0.0",
  "description": "GitHub Action to update Bun dependencies with proper latest version resolution",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "bundle": "tsc && npx rollup -c rollup.config.mjs",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs",
    "all": "bun run test && bun run bundle"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@octokit/action": "^8.0.4"
  },
  "devDependencies": {
    "@jest/globals": "30.3.0",
    "@rollup/plugin-commonjs": "29.0.2",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/jest": "30.0.0",
    "@types/node": "25.6.0",
    "jest": "30.3.0",
    "rollup": "4.60.3",
    "ts-jest": "29.4.9",
    "ts-jest-resolver": "2.0.1",
    "typescript": "6.0.3"
  }
}
