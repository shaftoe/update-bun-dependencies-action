{
  "name": "update-bun-dependencies-action",
  "version": "0.0.0",
  "description": "GitHub Action to update Bun dependencies with proper latest version resolution",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc",
    "bundle": "npm run build && npx rollup -c rollup.config.mjs",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs",
    "lint": "eslint src/",
    "all": "npm run lint && npm run test && npm run bundle"
  },
  "dependencies": {
    "@actions/core": "^1.11.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "jest": "^30.0.0",
    "rollup": "^4.40.0",
    "ts-jest": "^29.4.0",
    "ts-jest-resolver": "^2.0.0",
    "typescript": "^5.8.0"
  }
}
